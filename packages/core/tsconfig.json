{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "react": [
        "../../node_modules/@types/react"
      ],
      "@/*": [
        "./src/*"
      ],
      "@payload-config": [
        "./src/payload.config.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
