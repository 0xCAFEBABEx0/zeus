{
  "name": "zeus",
  "version": "1.0.0",
  "private": true,
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '@zeus/cms' --filter '@zeus/web' dev",
    "dev:cms": "bun --filter @zeus/cms dev",
    "dev:web": "bun --filter @zeus/web dev",
    "build": "bun run build:cms && bun run build:web",
    "build:cms": "bun --filter @zeus/cms build",
    "build:web": "bun --filter @zeus/web build",
    "ci": "bun run build",
    "generate:importmap": "bun --filter @zeus/cms generate:importmap",
    "generate:types": "bun --filter @zeus/cms generate:types",
    "payload": "bun --filter @zeus/cms payload",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation bun install --frozen-lockfile",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "bun --filter '@zeus/cms' --filter '@zeus/web' typecheck",
    "reinstall": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && rm -f bun.lock && bun install",
    "test": "echo \"Info: No tests specified\" && exit 0",
    "deploy:preview": "git checkout preview && git merge development && git push origin preview",
    "deploy:production": "git checkout main && git merge preview && git push origin main",
    "env:check": "node -e \"console.log('Environment:', process.env.NODE_ENV || 'development'); console.log('Vercel Env:', process.env.VERCEL_ENV || 'local');\""
  },
  "devDependencies": {
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "checkly": "^9.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "cross-env": "^10.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4 <23",
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@vercel/speed-insights",
    "unrs-resolver"
  ],
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@latest",
    "@esbuild-kit/core-utils": "npm:tsx@latest",
    "glob": "^10.4.5"
  }
}
