{
  "name": "payload-vercel-website-template",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation bun run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && bun run build && bun run start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation bun install --frozen-lockfile",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm -f bun.lock && bun install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "echo \"Info: No tests specified\" && exit 0",
    "deploy:preview": "git checkout preview && git merge development && git push origin preview",
    "deploy:production": "git checkout main && git merge preview && git push origin main",
    "env:check": "node -e \"console.log('Environment:', process.env.NODE_ENV || 'development'); console.log('Vercel Env:', process.env.VERCEL_ENV || 'local');\""
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.92.0",
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/db-vercel-postgres": "^3.92.0",
    "@payloadcms/live-preview-react": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/payload-cloud": "^3.92.0",
    "@payloadcms/plugin-form-builder": "^3.92.0",
    "@payloadcms/plugin-nested-docs": "^3.92.0",
    "@payloadcms/plugin-redirects": "^3.92.0",
    "@payloadcms/plugin-search": "^3.92.0",
    "@payloadcms/plugin-seo": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-vercel-blob": "^3.92.0",
    "@payloadcms/ui": "^3.92.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@sentry/nextjs": "^11.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "geist": "^1.8.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "payload": "^3.92.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "checkly": "^9.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "jiti": "^2.7.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.23.4 <23",
    "bun": ">=1.2.0"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@vercel/speed-insights",
    "unrs-resolver"
  ],
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@latest",
    "@esbuild-kit/core-utils": "npm:tsx@latest",
    "glob": "^10.4.5"
  }
}
