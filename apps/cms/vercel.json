{
  "buildCommand": "bun run build",
  "schedules": {
    "payload-jobs": {
      "schedule": "0 * * * *",
      "path": "/api/payload-jobs/run",
      "requestMethod": "GET"
    }
  },
  "functions": {
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 30
    }
  },
  "build": {
    "env": {
      "NODE_VERSION": "26"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "preview": true,
      "**": false
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
