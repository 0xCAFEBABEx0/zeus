---
import type { Media } from '@zeus/core/payload-types'

import { getMediaUrl, imgAttrs, isVideo } from '@/lib/media'

type Props = {
  resource: Media | string | number | null | undefined
  /** Image fills its positioned parent (port of next/image fill). */
  fill?: boolean
  imgClass?: string
  videoClass?: string
  pictureClass?: string
  loading?: 'lazy' | 'eager'
  sizes?: string
}

const {
  resource,
  fill = false,
  imgClass,
  videoClass,
  pictureClass,
  loading = 'lazy',
  sizes = '(max-width: 640px) 1280px, (max-width: 768px) 1536px, (max-width: 1024px) 2048px, (max-width: 1536px) 3072px, 100vw',
} = Astro.props

const media = resource && typeof resource === 'object' ? resource : null
const video = media && isVideo(media) ? media : null
const attrs = media && !video ? imgAttrs(media) : null

const fillClasses = fill ? 'absolute inset-0 h-full w-full object-cover' : ''
---

{
  video && (
    <video
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      aria-label={video.alt || undefined}
      class:list={[fillClasses, videoClass ?? imgClass]}
    >
      <source src={getMediaUrl(video.url, video.updatedAt)} type={video.mimeType ?? undefined} />
    </video>
  )
}
{
  attrs && (
    <picture class={pictureClass}>
      <img
        src={attrs.src}
        srcset={attrs.srcset}
        sizes={attrs.srcset ? sizes : undefined}
        width={!fill ? attrs.width : undefined}
        height={!fill ? attrs.height : undefined}
        alt={attrs.alt}
        loading={loading}
        decoding="async"
        class:list={[fillClasses, imgClass]}
      />
    </picture>
  )
}
