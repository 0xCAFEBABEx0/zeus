{
  "name": "@zeus/web",
  "version": "1.0.0",
  "private": true,
  "description": "Public website (ausor.ai)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack --port 3000",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zeus/core": "workspace:*",
    "cross-env": "^10.1.0",
    "geist": "^1.8.2",
    "next": "16.4.3",
    "next-sitemap": "^4.2.3",
    "payload": "^3.92.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
