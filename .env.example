# Database connection string
DATABASE_URL=postgres://user:password@hostname:5432/database?sslmode=require
# Blob storage token
BLOB_READ_WRITE_TOKEN=
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE
# Force use of Vercel Postgres
FORCE_USE_VERCEL_POSTGRES=true

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgres://user:password@hostname:5432/database?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@hostname:5432/database?sslmode=require
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=postgres://user:password@hostname:5432/database
POSTGRES_PRISMA_URL=postgres://user:password@hostname:5432/database?connect_timeout=15&sslmode=require

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Neon Auth environment variables for Next.js
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Checkly environment variables
CHECKLY_ACCOUNT_ID=
CHECKLY_API_KEY=

# Sentry environment variables
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
NEXT_PUBLIC_SENTRY_DSN=