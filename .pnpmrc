# Performance settings
shamefully-hoist=false
store-dir=~/.pnpm-store

# Security settings
auto-install-peers=false
strict-peer-dependencies=true

# Build script configuration
# Allow build scripts to run (required for @sentry/cli, @vercel/speed-insights, etc.)
ignore-scripts=false
enable-pre-post-scripts=true

# Note: In newer versions of pnpm, build scripts are approved via:
# 1. Using pnpm approve-builds command
# 2. Or by setting up package-specific exceptions 